# Overrides for docker-compose.yml — only needed when the app is reachable
# from somewhere other than localhost (e.g. a deployed EC2 instance), so the
# frontend bundle is built pointing at the right backend URL and the browser
# talks to the payment gateway sandbox directly.
#
# Copy to .env at the repo root (docker-compose reads it automatically).
# Not needed for plain local dev — the defaults already point at localhost.

VITE_API_BASE_URL=http://localhost:3000
VITE_WOMPI_SANDBOX_URL=https://api-sandbox.co.uat.wompi.dev/v1
VITE_WOMPI_PUBLIC_KEY=pub_stagtest_g2u0HQd3ZMh05hsSgTS2lUV8t3s4mOt7
FRONTEND_HOST_PORT=5173
